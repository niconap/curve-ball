#!/bin/bash
#SBATCH --job-name=comm20_hyp_flow_map
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=12:00:00
#SBATCH --output=outputs/comm20_hyp_flow_map_%j.out
#SBATCH --error=outputs/comm20_hyp_flow_map_%j.err

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load Mamba/24.9.0-0

source activate HypeFlow
export PYTHONPATH=$PYTHONPATH:$(pwd):$(pwd)/src/models/hyperbolic_nn_plusplus

# 2. WandB Setup
export WANDB_START_METHOD=thread
export WANDB_SILENT=true
if [ -f "wandb.key" ]; then
    export WANDB_API_KEY=$(cat wandb.key)
    export WANDB_MODE=online
    WANDB_LOG_MODE=online
    echo "WandB API key loaded from wandb.key"
elif [ -n "$WANDB_API_KEY" ]; then
    export WANDB_MODE=online
    WANDB_LOG_MODE=online
    echo "WandB API key found in environment"
else
    export WANDB_MODE=offline
    WANDB_LOG_MODE=offline
    echo "No WandB API key found. Using offline mode."
fi

# CURVATURES=(0.1 0.5 1.0 2.5 5.0)
# COMM20_VAE_CHECKPOINTS=(
#   "~/outputs/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction-comm20/VAE/2026-05-09/14-48-45/checkpoints/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction_c0.1/last-v1.ckpt"
#   "~/outputs/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction-comm20/VAE/2026-05-09/14-48-45/checkpoints/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction_c0.5/last-v1.ckpt"
#   "~/outputs/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction-comm20/VAE/2026-05-09/14-48-45/checkpoints/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction_c1.0/last-v1.ckpt"
#   "~/outputs/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction-comm20/VAE/2026-05-09/14-48-45/checkpoints/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction_c2.5/last-v1.ckpt"
#   "~/outputs/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction-comm20/VAE/2026-05-09/14-48-45/checkpoints/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction_c5.0/last-v1.ckpt"
# )

CURVATURE=1.0
COMM20_VAE_CHECKPOINT="~/outputs/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction-comm20/VAE/2026-05-09/14-48-45/checkpoints/comm20_VQVAE_32code_hyp64_euc0_decode_pairwise_interaction_c1.0/last-v1.ckpt"

FLOW_CHECKPOINT="${FLOW_CHECKPOINT:-None}"
TEST_ONLY="${TEST_ONLY:-false}"

# IDX="${SLURM_ARRAY_TASK_ID}"
# CURVATURE="${CURVATURES[$IDX]}"
# VAE_CHECKPOINT="${COMM20_VAE_CHECKPOINTS[$IDX]}"
VAE_CHECKPOINT="${COMM20_VAE_CHECKPOINT}"

if [[ "${VAE_CHECKPOINT}" == /path/to/* ]] || [ ! -f "${VAE_CHECKPOINT}" ]; then
  echo "Invalid VQ-VAE checkpoint for index=${IDX}: ${VAE_CHECKPOINT}"
  echo "Please replace placeholder paths in jobs/comm20_hyp_flow_array_rgvfm.job."
  exit 1
fi

echo "Curvature ${CURVATURE}"
echo "VQ-VAE checkpoint: ${VAE_CHECKPOINT}"
echo "Flow checkpoint: ${FLOW_CHECKPOINT}"
echo "Test only: ${TEST_ONLY}"

time python3 src/train_flow.py \
  +experiment=comm20_hyp \
  dataset=comm20 \
  loss=VQVAE \
  model.c="${CURVATURE}" \
  model.k_in="${CURVATURE}" \
  model.k_hidden="${CURVATURE}" \
  model.k_out="${CURVATURE}" \
  model.k_poin_out="$(awk "BEGIN {print 1/${CURVATURE}}")" \
  general.wandb="${WANDB_LOG_MODE}" \
  dataset.debug=false \
  model.hyp_channels=64 \
  model.latent_channels=64 \
  model.euc_channels=0 \
  loss.codebook_size=32 \
  general.samples_to_save=0 \
  flow_train.VAE_checkpoint="${VAE_CHECKPOINT}" \
  flow_train.Flow_checkpoint="${FLOW_CHECKPOINT}" \
  flow_train.test_only="${TEST_ONLY}" \
  flow_train.integrate.method=use_flow_map\
  flow_train.integrate.num_steps=4

