#!/bin/bash
#SBATCH --job-name=gen_synthetic
#SBATCH --partition=rome
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=01:00:00
#SBATCH --output=outputs/gen_synthetic_%j.out
#SBATCH --error=outputs/gen_synthetic_%j.err

# Adjust 'HypeFlow' to your actual conda environment name if different
module load 2024
module load Miniconda3/24.7.1-0
module load Mamba/24.9.0-0
source activate ~/.conda/envs/ggball
export PYTHONPATH=$PYTHONPATH:$(pwd):$(pwd)/src/models/hyperbolic_nn_plusplus

echo "=== ENV DEBUG ==="
which python3
conda info --envs
python3 -c "import sys; print('\n'.join(sys.path))"
echo "================="

# 2. Execution
# Generates 512 graphs for each of the 4 presets
echo "Starting synthetic dataset generation..."
~/.conda/envs/ggball/bin/python3 src/datasets/synthetic_generator.py --n-graphs 512 --workers 16
echo "Generation complete."
