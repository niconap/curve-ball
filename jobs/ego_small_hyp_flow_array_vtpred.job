#!/bin/bash
#SBATCH --job-name=vt_ego_small_hyp_flow
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=24:00:00
#SBATCH --array=0-4
#SBATCH --output=outputs/vt_ego_small_hyp_flow_%A_%a.out
#SBATCH --error=outputs/vt_ego_small_hyp_flow_%A_%a.err

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load Mamba/24.9.0-0

source activate HypeFlow
export PYTHONPATH=$PYTHONPATH:$(pwd):$(pwd)/src/models/hyperbolic_nn_plusplus

# 2. WandB Setup
export WANDB_START_METHOD=thread
export WANDB_SILENT=true
if [ -f "wandb.key" ]; then
    export WANDB_API_KEY=$(cat wandb.key)
    export WANDB_MODE=online
    WANDB_LOG_MODE=online
    echo "WandB API key loaded from wandb.key"
elif [ -n "$WANDB_API_KEY" ]; then
    export WANDB_MODE=online
    WANDB_LOG_MODE=online
    echo "WandB API key found in environment"
else
    export WANDB_MODE=offline
    WANDB_LOG_MODE=offline
    echo "No WandB API key found. Using offline mode."
fi

CURVATURES=(0.1 0.5 1.0 2.5 5.0)
EGO_SMALL_VAE_CHECKPOINTS=(
  "~/outputs/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c0.1-ego_small/VAE/2026-05-09/14-49-00/checkpoints/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c0.1/last-v1.ckpt"
  "~/outputs/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c0.5-ego_small/VAE/2026-05-09/14-48-45/checkpoints/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c0.5/last-v1.ckpt"
  "~/outputs/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c1.0-ego_small/VAE/2026-05-09/14-48-45/checkpoints/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c1.0/last-v1.ckpt"
  "~/outputs/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c2.5-ego_small/VAE/2026-05-09/14-48-45/checkpoints/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c2.5/last-v1.ckpt"
  "~/outputs/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c5.0-ego_small/VAE/2026-05-09/14-48-45/checkpoints/ego_small_VQVAE_32code_hyp64_euc0_decode_pairwise_interactiondecode_c5.0/last-v1.ckpt"
)

FLOW_CHECKPOINT="${FLOW_CHECKPOINT:-None}"
TEST_ONLY="${TEST_ONLY:-false}"

IDX="${SLURM_ARRAY_TASK_ID}"
CURVATURE="${CURVATURES[$IDX]}"
VAE_CHECKPOINT="${EGO_SMALL_VAE_CHECKPOINTS[$IDX]}"

if [[ "${VAE_CHECKPOINT}" == /path/to/* ]] || [ ! -f "${VAE_CHECKPOINT}" ]; then
  echo "Invalid VQ-VAE checkpoint for index=${IDX}: ${VAE_CHECKPOINT}"
  echo "Please replace placeholder paths in jobs/vt_ego_small_hyp_flow_array.job."
  exit 1
fi

echo "Array task ${IDX} / curvature ${CURVATURE}"
echo "VQ-VAE checkpoint: ${VAE_CHECKPOINT}"
echo "Flow checkpoint: ${FLOW_CHECKPOINT}"
echo "Test only: ${TEST_ONLY}"

time python3 src/train_flow.py \
  +experiment=ego_small_hyp \
  dataset=ego_small \
  loss=VQVAE \
  model.c="${CURVATURE}" \
  model.k_in="${CURVATURE}" \
  model.k_hidden="${CURVATURE}" \
  model.k_out="${CURVATURE}" \
  model.k_poin_out="$(awk "BEGIN {print 1/${CURVATURE}}")" \
  general.wandb="${WANDB_LOG_MODE}" \
  dataset.debug=false \
  model.hyp_channels=64 \
  model.latent_channels=64 \
  loss.codebook_size=32 \
  general.samples_to_save=0 \
  flow_train.VAE_checkpoint="${VAE_CHECKPOINT}" \
  flow_train.Flow_checkpoint="${FLOW_CHECKPOINT}" \
  flow_train.test_only="${TEST_ONLY}" \
  flow_train.integrate.method=vt_prediction
