#!/bin/bash
#SBATCH --job-name=synthetic_train
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=24:00:00
#SBATCH --array=0-0
#SBATCH --output=outputs/synthetic_train_%A_%a.out
#SBATCH --error=outputs/synthetic_train_%A_%a.err

# 1. Environment
module purge
module load 2024
module load Miniconda3/24.7.1-0
module load Mamba/24.9.0-0
source activate ~/.conda/envs/ggball
export PYTHONPATH=$PYTHONPATH:$(pwd):$(pwd)/src/models/hyperbolic_nn_plusplus

# 2. WandB Setup
export WANDB_START_METHOD=thread
export WANDB_SILENT=true
if [ -f "wandb.key" ]; then
    export WANDB_API_KEY=$(cat wandb.key)
    export WANDB_MODE=online
    WANDB_LOG_MODE=online
    echo "WandB API key loaded from wandb.key"
elif [ -n "$WANDB_API_KEY" ]; then
    export WANDB_MODE=online
    WANDB_LOG_MODE=online
    echo "WandB API key found in environment"
else
    export WANDB_MODE=offline
    WANDB_LOG_MODE=offline
    echo "No WandB API key found. Using offline mode."
fi

# 3. Dataset selection via Array ID
DATASETS=(
    "synthetic_very_low_gap_very_low_delta"
    "synthetic_low_gap_medium_delta"
    "synthetic_medium_gap_high_delta"
    "synthetic_high_gap_medium_delta"
)
DATASET=${DATASETS[$SLURM_ARRAY_TASK_ID]}
CURVATURE=1.0  # Default curvature, can be adjusted or added to the array sweep

echo "Array task ${SLURM_ARRAY_TASK_ID}: Training on ${DATASET} with c=${CURVATURE}"

# 4. Execution
time ~/.conda/envs/ggball/bin/python3 src/main.py \
   +experiment=ego_small_hyp \
   dataset=${DATASET} \
   loss=VQVAE \
   model.c=${CURVATURE} \
   general.wandb=${WANDB_LOG_MODE} \
   dataset.debug=false \
   model.hyp_channels=64 \
   model.latent_channels=64 \
   model.euc_channels=0 \
   loss.codebook_size=32 \
   train.n_epochs=20000
